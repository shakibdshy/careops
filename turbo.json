{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**", "cdk.out/**"]
    },
    // Every lane builds dependency packages first: @careops/shared resolves
    // through its compiled dist (Node ESM cannot load .js specifiers inside
    // source-exported .ts), so lint/typecheck/test need dist to exist.
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    // No package defines a `transit` script — per Turborepo's transit-node
    // pattern this gives `typecheck` correct cache invalidation for changes
    // in dependency package sources while staying parallel.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
