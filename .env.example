# Port the API listens on (web dev proxy targets this).
PORT=3001

# MongoDB connection string used by the API (docker compose maps 27017).
# Runs as a single-node replica set (rs0) so transactions are available.
MONGODB_URI=mongodb://localhost:27017/careops?replicaSet=rs0

# Redis connection string used by the API (docker compose maps 6379).
REDIS_URL=redis://localhost:6379

# BetterAuth signing secret, min 32 chars. NEVER commit a real secret.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Runtime environment: development | test | production
NODE_ENV=development

# SMTP transport for notification delivery. The default targets the Mailpit
# container in docker compose (SMTP :1025, web UI http://localhost:8025), so
# boot is self-contained with zero external keys. Point at a real relay in prod.
SMTP_URL=smtp://localhost:1025

# Envelope sender for outgoing notifications.
MAIL_FROM=CareOps <no-reply@careops.local>

# BullMQ queue name for notifications. Leave as-is unless you need to isolate
# consumers (the e2e harness overrides it per suite).
NOTIFICATIONS_QUEUE_NAME=notifications
