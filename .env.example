# Port the API listens on (web dev proxy targets this).
PORT=3001

# MongoDB connection string used by the API (docker compose maps 27017).
MONGODB_URI=mongodb://localhost:27017/careops

# Redis connection string used by the API (docker compose maps 6379).
REDIS_URL=redis://localhost:6379

# BetterAuth signing secret, min 32 chars. NEVER commit a real secret.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Runtime environment: development | test | production
NODE_ENV=development
